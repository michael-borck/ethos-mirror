# ── LLM configuration (optional) ────────────────────────────────────────────
# Ethos Mirror talks to any OpenAI-compatible chat completions endpoint.
# Leave these unset and the philosophy builder falls back to a structured
# scaffold assembled from the educator's own words (no AI involved).

# Ollama (local, free):
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.2
# LLM_API_KEY=              # not required for Ollama

# OpenRouter (hosted, has free-tier models):
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
# LLM_API_KEY=sk-or-v1-...

# OpenAI:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=sk-...

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3001
